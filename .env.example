# ---- App gate (Phase 3) ----
APP_PASSWORD=change-me

# ---- Anthropic (Phase 2) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Supabase (storage) ----
# Server-side only. Use the service role key on the server; never expose to browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...

# ---- Local dev fallback ----
# When Supabase env vars are absent, the app reads/writes a local JSON file so
# you can develop and verify formatting without a cloud project.
